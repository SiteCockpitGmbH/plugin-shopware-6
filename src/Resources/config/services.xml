<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="SiteCockpitEasyVisionShopware6\Core\Content\DomainSitekey\DomainSitekeyDefinition">
            <tag name="shopware.entity.definition" entity="domain_sitekey" />
        </service>
        <service id="SiteCockpitEasyVisionShopware6\Twig\GetCodePerDomain" public="true">
            <tag name="twig.extension"/>
            <argument type="service" id="domain_sitekey.repository"/>
        </service>
    </services>
</container>