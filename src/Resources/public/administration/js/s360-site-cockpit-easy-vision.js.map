export default "<sw-page class=\"site-cockpit\">\n    <template #smart-bar-header>\n        <h2>\n            {{ $t('siteCockpit.general.title') }}\n        </h2>\n    </template>\n\n    <template #content>\n        <div class=\"sw-card-wrapper\">\n            <div class=\"sw-card\">\n                <div class=\"sw-card__content\">\n                    <h1>\n                        {{ $t('siteCockpit.general.configurationTitle') }}\n                    </h1>\n                    <sw-entity-single-select\n                            :label=\"$t('siteCockpit.general.labelDomain')\"\n                            id=\"domain\"\n                            label-property=\"url\"\n                            entity=\"sales_channel_domain\"\n                            :criteria=\"domainFilter\"\n                            v-model:value=\"domainId\"\n                            @update:value=\"changeDomain\"\n                            @change=\"changeDomain\"\n                    />\n                    <sw-text-field\n                            v-model:value=\"sitekey\"\n                            :placeholder=\"$t('siteCockpit.general.siteKeyPlaceholder')\"\n                            :label=\"$t('siteCockpit.general.labelSiteKey')\"\n                    />\n                    <sw-button\n                            class=\"sw-button sw-button--primary\"\n                            :isLoading=\"loading\"\n                            @click=\"onSubmit\"\n                            variant=\"primary\"\n                    >\n                        {{ $t('siteCockpit.general.save') }}\n                    </sw-button>\n                    <br/>\n                    <br/>\n                    <p v-html=\"$t('siteCockpit.general.helpText')\">\n                    </p>\n                    <div>\n                        <br/>\n                        <a :href=\"$t('siteCockpit.general.linkAddress')\">\n                            {{ $t('siteCockpit.general.linkTitle') }}\n                        </a>\n                        <br/>\n                        <br/>\n                        <a :href=\"$t('siteCockpit.general.helpLinkAddress')\">\n                            {{ $t('siteCockpit.general.helpLinkTitle') }}\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </template>\n</sw-page>";