export default "<sw-page class=\"site-cockpit\">\n    <template #smart-bar-header>\n        <h2> {{ $t('siteCockpit.general.title') }}</h2>\n    </template>\n\n    <template #content>\n        <div class=\"sw-card-wrapper\">\n            <div class=\"sw-card\">\n                <div class=\"sw-card__content\">\n                    <h1> {{ $t('siteCockpit.general.configurationTitle') }}</h1>\n                    <sw-entity-single-select\n                            :label=\"$t('siteCockpit.general.helpLinkTitle')\"\n                            id=\"domain\"\n                            label-property=\"url\"\n                            entity=\"sales_channel_domain\"\n                            :criteria=\"domainFilter\"\n                            {% if VUE3 %}\n                                v-model:value=\"domainId\"\n                            {% else %}\n                                v-model=\"domainId\"\n                            {% endif %}\n                            {% if VUE3 %}\n                                @update:value=\"changeDomain\"\n                            {% else %}\n                                @change=\"changeDomain\"\n                            {% endif %}\n                    />\n                    <sw-text-field v-model:value=\"sitekey\"/>\n                    <button\n                            class=\"sw-button sw-button--primary\"\n                            :disabled=\"loading\"\n                            @click=\"onSubmit\"\n                    >\n                        {{ $t('siteCockpit.general.save') }}\n                    </button>\n                    <div>\n                        <br>\n                        <a :href=\"$t('siteCockpit.general.linkAddress')\">\n                            {{ $t('siteCockpit.general.linkTitle') }}\n                        </a>\n                        <a :href=\"$t('siteCockpit.general.helpLinkAddress')\">\n                            {{ $t('siteCockpit.general.helpLinkTitle') }}\n                        </a>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </template>\n</sw-page>";